# ============================================
# .gitignore — cosmetic-checker
# 「秘密情報・自動生成物・個人環境ファイル」はpushしない
# ※ rails new が生成した .gitignore がある場合は、この内容とマージする
# ============================================

# --- 秘密情報(絶対にコミットしない) ---
.env
.env.*
!.env.example
/config/master.key
/config/credentials/*.key

# --- ログ・一時ファイル ---
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep

# --- ローカルストレージ(アップロード物など) ---
/storage/*
!/storage/.keep

# --- ビルド成果物・キャッシュ ---
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
.bundle

# --- 依存パッケージ(再生成できる) ---
/node_modules

# --- DBダンプ・バックアップ ---
*.sql
*.dump
*.sqlite3
*.sqlite3-*

# --- OS・エディタが作るファイル ---
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# --- Claude Code のローカル設定(個人用) ---
# .claude/settings.json はチーム共有用なのでコミットしてOK
# settings.local.json は個人環境用なので除外する
.claude/settings.local.json

# --- Claude と進める開発の作業ファイル(ローカル専用) ---
# プラン・実装ログ・Claude 用コマンドは個人の作業メモなのでpushしない
/docs/development_plan/
/docs/development_log/
/.claude/commands/

# ============================================
# 【メモ】コミットして良いもの(除外しない)
#   .claude/CLAUDE.md / .claude/settings.json / README.md
#   docs/CAUTION_CRITERIA.md / .env.example(値なしの見本)
# ============================================